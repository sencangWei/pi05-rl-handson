diff --git a/rlinf/envs/sim/libero/recovery.py b/rlinf/envs/sim/libero/recovery.py
new file mode 100644
index 0000000..1ba0249
--- /dev/null
+++ b/rlinf/envs/sim/libero/recovery.py
@@ -0,0 +1,63 @@
+"""Opt-in reproducible failure starts and released-bowl success for LIBERO goal 8."""
+import hashlib
+import json
+from pathlib import Path
+
+import numpy as np
+
+
+class RecoveryEnv:
+    def __init__(self, wrapped, config):
+        self.wrapped = wrapped
+        self.manifest_path = Path(config["manifest"])
+        manifest = json.loads(self.manifest_path.read_text())
+        if manifest["task_suite"] != "libero_goal" or manifest["task_id"] != 8:
+            raise ValueError("Recovery bank must describe LIBERO goal 8")
+        split = config["split"]
+        if split not in ("train", "heldout"):
+            raise ValueError("Unknown recovery split")
+        self.entries = [item for item in manifest["entries"] if item["split"] == split]
+        if not self.entries:
+            raise ValueError("Empty recovery split")
+        self.streak = 0
+        self.active_entry = None
+
+    def __getattr__(self, name):
+        return getattr(self.wrapped, name)
+
+    def set_init_state(self, state):
+        self.streak = 0
+        return self.wrapped.set_init_state(state)
+
+    def restore_recovery(self, index):
+        entry = self.entries[int(index) % len(self.entries)]
+        path = self.manifest_path.parent / entry["file"]
+        if hashlib.sha256(path.read_bytes()).hexdigest() != entry["sha256"]:
+            raise ValueError("Recovery state file hash differs from manifest")
+        with np.load(path, allow_pickle=False) as data:
+            state = data["state"]
+        if hashlib.sha256(state.tobytes()).hexdigest() != entry["state_sha256"]:
+            raise ValueError("Recovery state content hash differs from manifest")
+        obs = self.set_init_state(state)
+        self.active_entry = entry
+        if self.wrapped.check_success():
+            raise ValueError("Recovery initial state already satisfies native goal")
+        print("RECOVERY_INITIAL " + json.dumps({key: entry[key] for key in
+              ("id", "category", "split", "state_sha256")}), flush=True)
+        return obs
+
+    def step(self, action):
+        obs, _, _, info = self.wrapped.step(action)
+        native = bool(self.wrapped.check_success())
+        env = self.wrapped.env
+        contact = bool(env.check_contact(env.robots[0].gripper.contact_geoms,
+                                         env.get_object("akita_black_bowl_1")))
+        self.streak = self.streak + 1 if native and not contact else 0
+        success = self.streak >= 5
+        info = dict(info, native_success=native, released_success=success,
+                    release_streak=self.streak, finger_contact=contact)
+        return obs, float(success), success, info
+
+
+def wrap_recovery(env, config):
+    return RecoveryEnv(env, config) if config else env
