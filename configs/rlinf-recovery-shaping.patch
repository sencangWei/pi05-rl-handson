+    def potential(self):
+        """Bounded task progress from simulator state, used only for training reward."""
+        env = self.wrapped.env
+        bowl_object = env.get_object("akita_black_bowl_1")
+        bowl = env.sim.data.body_xpos[env.obj_body_id["akita_black_bowl_1"]]
+        plate = env.sim.data.body_xpos[env.obj_body_id["plate_1"]]
+        hand = env.sim.data.site_xpos[env.robots[0].eef_site_id]
+        grasped = bool(env._check_grasp(env.robots[0].gripper, bowl_object))
+        resting_z = env.workspace_offset[2] - bowl_object.bottom_offset[2]
+        reach = 1. - np.tanh(np.linalg.norm(hand - (bowl + [0, 0, .04])) / .10)
+        lift = float(np.clip((bowl[2] - resting_z - .01) / .08, 0., 1.))
+        transport = 1. - np.tanh(np.linalg.norm((bowl - plate)[:2]) / .15)
+        native = bool(self.wrapped.check_success())
+        return float(.2 * reach + .2 * grasped + .2 * grasped * lift
+                     + .3 * grasped * lift * transport + .1 * native)
