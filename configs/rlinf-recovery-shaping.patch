+def shape_chunk_rewards(rewards, potentials_before, potentials_after, dones,
+                        terminations, scale, gamma):
+    """Add one discounted potential difference per chunk; mask after its first done.
+
+    PPO sums controls without discount, then applies gamma once per chunk.
+    True terminals use zero endpoint potential. Timeouts keep their endpoint
+    because the trajectory layer bootstraps the final value at truncations.
+    """
+    if not 0. <= scale <= 1. or not 0. < gamma <= 1.:
+        raise ValueError("Expected shaping scale in [0,1] and gamma in (0,1]")
+    rewards = np.asarray(rewards).copy()
+    dones = np.asarray(dones, dtype=bool)
+    rows = np.arange(len(rewards))
+    ended = dones.any(axis=1)
+    ends = np.where(ended, dones.argmax(axis=1), rewards.shape[1] - 1)
+    rewards[np.arange(rewards.shape[1])[None, :] > ends[:, None]] = 0.
+    start = np.asarray(potentials_before)[:, 0]
+    finish = np.asarray(potentials_after)[rows, ends]
+    terminal = np.asarray(terminations, dtype=bool)[rows, ends]
+    shaping = scale * (gamma * np.where(terminal, 0., finish) - start)
+    rewards[rows, ends] += shaping
+    return rewards
